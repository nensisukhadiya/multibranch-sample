pipeline {
    agent any

    stages {
        stage('Hello') {
            steps {
                echo 'Hello, everyone! This is jenkins multibranch demo'
            }
        }
    }
    stage('Create File') {
            steps {
                script {
                    sh 'echo "Hello, World!" > hello.txt'
                    sh 'cat hello.txt'
                }
            }
    }
}
